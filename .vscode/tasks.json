{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar LaTeX (Tectonic)",
            "type": "shell",
            "command": "C:/Users/Arnol's/bin/tectonic.exe",
            "args": [
                "${fileBasename}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$latex"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
